# DESIGN SKELETON ONLY. This file is intentionally non-runnable.
# The production operator must resolve every REPLACE_ value before creating a VM.
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: windows11-analysis-template
  labels:
    app.kubernetes.io/name: malzone
    malzone.io/template-purpose: analysis-skeleton
  annotations:
    malzone.io/example-only: "true"
spec:
  runStrategy: Halted
  template:
    metadata:
      labels:
        app.kubernetes.io/name: malzone
        malzone.io/analysis: REPLACE_ANALYSIS_ID
        malzone.io/session: REPLACE_SESSION_ID
    spec:
      nodeSelector:
        kubernetes.io/arch: amd64
        malzone.io/analysis-node: "true"
      terminationGracePeriodSeconds: 30
      domain:
        machine:
          type: q35
        cpu:
          cores: 4
          model: host-model
        memory:
          guest: 8Gi
        firmware:
          bootloader:
            efi:
              secureBoot: true
        features:
          smm:
            enabled: true
        devices:
          autoattachPodInterface: false
          tpm: {}
          disks:
            - name: rootdisk
              disk:
                bus: virtio
              bootOrder: 1
          interfaces:
            - name: management
              bridge: {}
            - name: detonation
              bridge: {}
      networks:
        - name: management
          multus:
            networkName: REPLACE_MANAGEMENT_NAD
        - name: detonation
          multus:
            networkName: REPLACE_DETONATION_NAD
      volumes:
        - name: rootdisk
          persistentVolumeClaim:
            claimName: REPLACE_WRITABLE_GOLDEN_CLONE_PVC
